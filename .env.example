# 复制为 .env 后填写；config/config.yaml 里用 `env:XXX` 引用这些变量。
# 注意：.env 已在 .gitignore 中，不要提交真实密钥。

# --- GitHub ---
# 轮询用的 token（可选，但建议配置：提高 API 限额 + 可读取私有仓库）
GITHUB_TOKEN=
# webhook HMAC 校验密钥，必须与 GitHub 仓库 webhook 里填的 Secret 一致
GITHUB_WEBHOOK_SECRET=

# --- 飞书自定义机器人（transport: webhook）---
# 群设置 -> 群机器人 -> 添加机器人 -> 自定义机器人 -> 复制 webhook 地址
FEISHU_WEBHOOK_DEV_FRONTEND=
# 机器人开启「签名校验」时填写，否则留空
FEISHU_WEBHOOK_SECRET_DEV_FRONTEND=

# --- 飞书自建应用（transport: app）---
# 开发者后台 -> 凭证与基础信息；需要开通 im:message:send_as_bot（发消息）+ im:chat:readonly（列群/查群主）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 群内指令（@机器人 sub/unsub）需要事件订阅，这个值在
# 开发者后台 -> 事件与回调 -> 加密策略 里（Encrypt Key 请留空，本版本不支持加密回调）
FEISHU_VERIFICATION_TOKEN=

# --- larkbot 自身 ---
# 管理接口 /admin/* 的凭证，留空则关闭管理接口
LARKBOT_ADMIN_TOKEN=
# 配置文件路径，默认 config/config.yaml
LARKBOT_CONFIG=
# 状态库路径，默认 data/larkbot.db
LARKBOT_DB=
# DEBUG / INFO / WARNING
LARKBOT_LOG_LEVEL=INFO
